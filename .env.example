# ─── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Database ──────────────────────────────────────────
# Local dev: postgresql+asyncpg://postgres:password@localhost:5432/docpipe
# Neon: postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/docpipe?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/docpipe

# ─── Prefect Cloud ─────────────────────────────────────
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=pnu_...

# ─── App ───────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
APP_ENV=development
